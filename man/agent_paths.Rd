\name{agent_paths}
\alias{agent_paths}
\title{Standard paths for a named cerebro agent}
\usage{
agent_paths(name, root = "~")
}
\arguments{
\item{name}{Character. Agent/instance name under \code{root}, e.g.
\code{"myassistant"} resolves under \code{~/myassistant}.}

\item{root}{Character. Parent directory for named agents.}
}
\value{
Named list of standard paths.
}
\description{
Standard paths for a named cerebro agent
}
